task dep:
    echo "dep-output"

task root: [dep]
    echo "root-output"

task confirm-task:
    @confirm "Proceed from Web UI?"
    echo "confirmed-output"

task slow:
    sleep 10

task fails:
    exit 1

task slow-left:
    sleep 10

task slow-right:
    sleep 10

task parallel-slow: [slow-left, slow-right]
    echo completed
